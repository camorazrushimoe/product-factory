# ============================================================
# Product Factory — environment template (real values go in .env,
# which is NOT committed). Copy: cp .env.example .env
# ============================================================

# --- LLM (runinfra, one key shared by all agents) ---
CUSTOM_API_KEY=

# --- Office attach (Office-attached mode = DEFAULT compose) ---
# Instance id: qualifies container names and bus actor ids.
TEAM_NAME=product-factory
# Office shared Redis bus (service name 'shared-memory' on agent-office-crew).
OFFICE_BUS_URL=redis://shared-memory:6379
# Per-agent door HMAC secrets (must match crew/agents.json + config.yaml.template).
DOOR_SECRET_TECHNICAL_PRODUCT_MANAGER=
DOOR_SECRET_PRODUCT_RESEARCHER=
DOOR_SECRET_SYSTEM_DOMAIN_ANALYST=
DOOR_SECRET_ADVERSARIAL_REVIEWER=
# Optional host port overrides (defaults: 8651–8654).
# SPEC_PORT_TECHNICAL_PRODUCT_MANAGER=8681
# SPEC_PORT_PRODUCT_RESEARCHER=8682
# SPEC_PORT_SYSTEM_DOMAIN_ANALYST=8683
# SPEC_PORT_ADVERSARIAL_REVIEWER=8684

# --- Hermes process user inside containers ---
HERMES_UID=501
HERMES_GID=20
